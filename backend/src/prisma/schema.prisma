// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email  String  @unique
  name   String
  avatar String?

  provider   String
  providerId String 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links Link[]

  @@unique([provider, providerId])
}

model Link {
  id       String @id @default(uuid())
  shortUrl String @unique
  longUrl  String @db.VarChar(2048)
  clicks   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  qrCode QrCode? // optional — null if user never generated one 

  @@index([userId])
}

model QrCode {
  id     String @id @default(uuid())
  linkId String @unique // enforces one-to-one: a link has at most one QR record
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // downloads     Int   @default(0)
  customization Json? // color, logo, size — open-ended for future features, no migration needed to add options

  createdAt DateTime @default(now())
}