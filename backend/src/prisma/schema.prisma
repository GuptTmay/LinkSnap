// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email  String  @unique
  name   String
  avatar String?

  provider   String
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links Link[]
  tags Tag[] 

  @@unique([provider, providerId])
}

model Link {
  id       String @id @default(uuid())
  shortUrl String @unique
  longUrl  String @db.VarChar(2048)
  title    String? @db.VarChar(64) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  qrCode     QrCode? // optional — null if user never generated one 
  linkClicks LinkClick[]

  tags LinkTag[]

  @@index([userId])
}

model QrCode {
  id     String @id @default(uuid())
  linkId String @unique // enforces one-to-one: a link has at most one QR record
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  customization Json? // color, logo, size — open-ended for future features, no migration needed to add options

  createdAt DateTime @default(now())
}

model LinkClick {
  id     String @id @default(uuid())
  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  referrer  String?

  os      String?
  country String?
  device  String?
  browser String?

  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  links LinkTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model LinkTag {
  linkId String
  tagId  String

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
}